# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env   &&   edit .env
# `.env` is git-ignored, so your real key is never committed.

# --- SEC EDGAR ----------------------------------------------------------------
# EDGAR requires a descriptive User-Agent that includes contact info, or it
# throttles/blocks you. Put a real contact address here. Never hardcoded in code.
SEC_USER_AGENT="Filing Analyst research project (you@example.com)"

# --- LLM provider (default: Fireworks) ----------------------------------------
# Get a key at https://app.fireworks.ai/ (Account -> API Keys).
FIREWORKS_API_KEY=fw_your_key_here

# --- Optional: point the whole stack at a different OpenAI-compatible provider -
# Uncomment and set these to override the Fireworks defaults. No code changes
# are needed to switch providers.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your_key_here
# LLM_CHAT_MODEL=gpt-4o
# LLM_EMBED_MODEL=text-embedding-3-small
